---
import SectionHeader from "../components/SectionHeader.astro";
import { services } from "../data/services";

const icons: Record<string, string> = {
  utensils:
    '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2M7 2v20M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/>',
  cake:
    '<path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8M4 16s.5-1 2-1 2.5 2 3 2 1.5-2 3-2 2.5 2 3 2 1.5-2 3-2 2 1 2 1M16 11V6a2 2 0 0 0-4 0v2M8 11V8a2 2 0 0 1 4 0M2 21h20"/>',
  users:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  leaf:
    '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10zM2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  search:
    '<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35M8 11h6M11 8v6"/>',
  pen:
    '<path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/>',
};
---

<section id="services" class="scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeader
      index="05 · Services"
      title="Comment je peux vous aider"
      intro="Des prestations simples et claires, pour les particuliers, les familles, les restaurants et les structures professionnelles."
    />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <div
            data-reveal
            class="group flex flex-col rounded-2xl border border-line bg-surface p-6 transition-all hover:-translate-y-1 hover:border-accent/60 hover:shadow-card"
            style={`--reveal-delay: ${(i % 3) * 90}ms`}
          >
            <span class="mb-5 inline-flex size-11 items-center justify-center rounded-xl bg-hero-well text-accent transition-colors group-hover:bg-accent group-hover:text-on-accent">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[service.icon]} aria-hidden="true" />
            </span>
            <h3 class="font-display text-lg font-semibold tracking-tight">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{service.description}</p>
            <ul class="mt-4 space-y-1.5 border-t border-line pt-4">
              {
                service.points.map((p) => (
                  <li class="flex gap-2.5 text-sm text-ink-soft">
                    <span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
                    {p}
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>