---
import SectionHeader from "../components/SectionHeader.astro";
import { projects } from "../data/projects";
import { publicUrl } from "../utils/path";

const categories = [
  { key: "all", label: "Tout" },
  { key: "cuisine", label: "Cuisine" },
  { key: "patisserie", label: "Pâtisserie" },
  { key: "organisation", label: "Organisation" },
  { key: "entreprenariat", label: "Entrepreneuriat" },
] as const;

const categoryMeta: Record<string, { label: string; glyph: string }> = {
  cuisine: { label: "Cuisine", glyph: "Assiette" },
  patisserie: { label: "Pâtisserie", glyph: "Douceur" },
  organisation: { label: "Organisation", glyph: "Méthode" },
  entreprenariat: { label: "Entrepreneuriat", glyph: "Projet" },
};
---

<section id="realisations" class="scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeader
      index="03 · Réalisations"
      title="Mes réalisations & prestations"
      intro="Une approche par problème et solution : pour chaque prestation, le besoin rencontré et la démarche appliquée."
    />

    <div data-filter-root data-reveal class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filtrer les réalisations">
      {
        categories.map((cat) => (
          <button
            type="button"
            data-filter-btn
            data-filter={cat.key}
            aria-pressed={cat.key === "all"}
            class:list={[
              "rounded-full border px-4 py-2 text-sm font-medium transition-all",
              cat.key === "all"
                ? "is-active border-accent bg-accent text-on-accent"
                : "border-line bg-surface text-muted hover:border-accent hover:text-accent",
            ]}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        projects.map((project, i) => (
          <article
            data-filter-card={project.category}
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
            class="flex flex-col rounded-2xl border border-line bg-surface p-6 transition-opacity duration-300"
          >
            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-2 rounded-full bg-hero-well px-3 py-1 text-xs font-semibold text-accent">
                {categoryMeta[project.category].label}
              </span>
              <span class="font-display text-sm italic text-gold">
                {categoryMeta[project.category].glyph}
              </span>
            </div>

            {
              project.image && (
                <div class="mb-5 overflow-hidden rounded-xl border border-line bg-surface-2">
                  <img
                    src={publicUrl(project.image)}
                    alt={project.imageAlt ?? project.name}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="500"
                    class="aspect-[16/10] w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
                  />
                </div>
              )
            }

            <h3 class="font-display text-xl font-semibold tracking-tight">
              {project.name}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              {project.summary}
            </p>

            <div class="mt-5 space-y-4">
              <div>
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-ink-soft">
                  Contexte — le besoin
                </p>
                <p class="text-sm leading-relaxed text-ink-soft">{project.context}</p>
              </div>
              <div>
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-ink-soft">
                  Ma démarche
                </p>
                <ul class="space-y-1.5">
                  {
                    project.approach.map((step) => (
                      <li class="flex gap-2.5 text-sm text-muted">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M20 6L9 17l-5-5"></path>
                        </svg>
                        {step}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-4">
              {
                project.tags.map((tag) => (
                  <span class="rounded-md border border-line bg-surface-2 px-2.5 py-1 text-xs text-muted">
                    {tag}
                  </span>
                ))
              }
            </div>

            {
              project.link && (
                <a
                  href={project.link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-soft"
                >
                  {project.link.label}
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M8 7h9v9"></path>
                  </svg>
                </a>
              )
            }
          </article>
        ))
      }
    </div>
  </div>
</section>