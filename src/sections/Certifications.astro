---
import SectionHeader from "../components/SectionHeader.astro";
import { certifications } from "../data/certifications";
---

<section id="formations" class="scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeader
      index="07 · Formations"
      title="Formations & diplômes"
      intro="Un parcours académique en sociologie, complété par une formation bureautique."
    />

    <div class="grid gap-5 sm:grid-cols-2">
      {
        certifications.map((cert, i) => (
          <div
            data-reveal
            class="flex items-start justify-between gap-4 rounded-2xl border border-line bg-surface p-6 transition-all hover:-translate-y-0.5 hover:border-accent/60"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-display text-lg font-semibold tracking-tight">
                  {cert.title}
                </h3>
                {cert.status && (
                  <span class="rounded-full bg-hero-well px-2.5 py-0.5 text-[11px] font-semibold text-accent">
                    {cert.status}
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-sm text-ink-soft">{cert.organization}</p>
              {cert.url && (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-soft"
                >
                  Justificatif
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M8 7h9v9"></path>
                  </svg>
                </a>
              )}
            </div>
            <span class="shrink-0 rounded-lg border border-line bg-surface-2 px-3 py-1.5 text-xs font-semibold text-muted">
              {cert.year}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>