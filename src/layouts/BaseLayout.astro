---
import "../styles/global.css";
import { site, meta } from "../data/site";
import { navLinks } from "../data/nav";
import { publicUrl } from "../utils/path";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const fullTitle = title ?? `${site.name} — ${site.title}`;
const fullDescription = description ?? meta.description;

const { pathname } = Astro.url;
const pageUrl = new URL(pathname, Astro.site).toString();
const year = new Date().getFullYear();
const ogImageUrl = new URL(publicUrl(meta.ogImage), Astro.site).toString();

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.title,
  email: site.email,
  telephone: site.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.location.split(",")[0].trim(),
    addressCountry: "SN",
  },
  knowsLanguage: ["fr", "wo"],
  description: site.tagline,
});
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={fullDescription} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={meta.themeColorDark} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={meta.themeColorLight} />

    <link rel="icon" type="image/svg+xml" href={publicUrl("/favicon.svg")} />
    <link rel="manifest" href={publicUrl("/site.webmanifest")} />

    <!-- Polices -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Thème : sombre par défaut, appliqué avant le paint pour éviter le flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light") {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>

    <!-- Données structurées : personne -->
    <script is:inline type="application/ld+json" set:html={personJsonLd}></script>
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-on-accent"
    >
      Aller au contenu
    </a>

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <div class="grain" aria-hidden="true"></div>

    <header class="fixed inset-x-0 top-0 z-[60] border-b border-line/60 bg-bg/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
        <a href="#accueil" class="group flex items-center gap-3" aria-label="Retour à l'accueil">
          <span
            class="grid size-9 place-items-center rounded-full border border-line bg-surface font-display text-sm font-semibold text-accent transition-colors group-hover:border-accent"
          >
            M
          </span>
          <span class="flex flex-col leading-tight">
            <span class="text-sm font-semibold tracking-tight">Mareme Seck</span>
            <span class="text-xs text-muted">Cuisinière & Sociologue</span>
          </span>
        </a>

        <nav class="hidden items-center gap-6 lg:flex" aria-label="Navigation principale">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                data-spy
                class="text-sm text-muted transition-colors hover:text-ink [&.active]:text-accent"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-theme-toggle
            aria-pressed="true"
            aria-label="Passer au mode clair"
            class="inline-flex size-9 items-center justify-center rounded-lg border border-line bg-surface text-muted transition-colors hover:border-accent hover:text-accent"
          >
            <svg data-icon-sun viewBox="0 0 24 24" class="hidden size-4 dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg data-icon-moon viewBox="0 0 24 24" class="block size-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <button
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="menu-mobile"
            class="inline-flex size-9 items-center justify-center rounded-lg border border-line bg-surface text-muted transition-colors hover:border-accent hover:text-accent lg:hidden"
            aria-label="Ouvrir le menu"
          >
            <svg data-icon-open viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg data-icon-close viewBox="0 0 24 24" class="hidden size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
      </div>

      <div
        id="menu-mobile"
        data-menu-panel
        aria-hidden="true"
        class="border-t border-line/60 bg-bg/95 backdrop-blur-md lg:hidden"
      >
        <nav class="mx-auto flex max-w-6xl flex-col px-5 py-4 sm:px-8" aria-label="Navigation mobile">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="border-b border-line/50 py-3 text-sm text-muted transition-colors last:border-0 hover:text-accent"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-12 text-center sm:px-8"
      >
        <div class="flex flex-col items-center gap-2">
          <span class="font-display text-xl font-semibold">{site.name}</span>
          <p class="max-w-md text-sm text-muted">
            Cuisine sénégalaise, pâtisserie & recherche sociologique — Dakar, Sénégal.
          </p>
        </div>

        {
          site.socials.length > 0 && (
            <div class="flex items-center gap-3">
              {site.socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-surface text-muted transition-colors hover:border-accent hover:text-accent"
                  aria-label={s.label}
                >
                  {s.label.slice(0, 1).toUpperCase()}
                </a>
              ))}
            </div>
          )
        }

        <p class="text-xs text-muted">
          © {year} {site.name} — Cuisinière & Sociologue. Tous droits réservés.
        </p>
      </div>
    </footer>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>